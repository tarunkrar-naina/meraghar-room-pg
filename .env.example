# ------------------------------------------------------------------
# MeraGhar - environment variables
# Copy this file to `.env.local` and fill in your values.
# Never commit real secrets. Only NEXT_PUBLIC_* values are safe in the browser.
# ------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (SERVER-SIDE ONLY - never expose this)
# Find it: Supabase Dashboard > Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used for sitemap/SEO/Open Graph (Vercel sets this in prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL: Google Maps key for the map section on property details.
# The app works fine without it (map block is hidden).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Groq API key (server-side only) - powers the AI agent chat on the site
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# OPTIONAL: SEO & analytics
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (enables GA4 on the site)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ------------------------------------------------------------------
# Admin panel access control
# Comma-separated list of emails that are ALLOWED to sign in to /admin.
# A user also needs role = 'admin' in the public.profiles table.
# Leaving this empty locks everyone out of the admin panel.
# ------------------------------------------------------------------
ADMIN_EMAILS=nainatarun41@gmail.com,admin@meraghar.in

# ------------------------------------------------------------------
# Vercel deploy button in /admin/deploy (all OPTIONAL).
# Without these the deploy page still loads, but the button stays disabled.
# VERCEL_TOKEN:      Vercel Dashboard > Account Settings > Tokens
# VERCEL_PROJECT_ID: Project > Settings > General > Project ID
# VERCEL_GIT_ORG / VERCEL_GIT_REPO: the GitHub repo connected to Vercel
# VERCEL_TEAM_ID:    only if the project sits under a Vercel team scope
# ------------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_GIT_ORG=
VERCEL_GIT_REPO=
VERCEL_TEAM_ID=
VERCEL_GIT_REF=main

# ------------------------------------------------------------------
# Monetization (Razorpay) — all OPTIONAL.
# Leave blank to disable payments: the app falls back to the free flow.
# Find them: Razorpay Dashboard > Settings > API Keys
# ------------------------------------------------------------------
RAZORPAY_KEY_ID=
# SERVER-SIDE ONLY - never expose this
RAZORPAY_KEY_SECRET=
# Used to verify webhook signature authenticity
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# Feature flags — set to "true"/"1" to switch a feature on.
# Both default to off, so payments stay disabled until you opt in.
# ------------------------------------------------------------------
# Show the "reveal owner contact" paid flow
ENABLE_CONTACT_REVEAL_PAYMENT=
# Show the "featured listing" paid boost
ENABLE_FEATURED_LISTINGS=

# Price in INR (paise) for one-time purchases
CONTACT_REVEAL_PRICE=199
FEATURED_PRICE_7_DAYS=99
FEATURED_PRICE_30_DAYS=249

# ------------------------------------------------------------------
# Analytics: salt used to hash visitor identifiers before storing them.
# Set a long random string in production. Changing it invalidates old hashes.
# ------------------------------------------------------------------
VISITOR_HASH_SALT=

