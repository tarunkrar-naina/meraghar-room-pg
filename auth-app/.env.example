# =====================================================================
# MeraGhar Auth - environment template
# ---------------------------------------------------------------------
# SETUP:  copy this file to  .env  and fill in the real values.
#   Windows (PowerShell):  copy .env.example .env
#   macOS / Linux       :  cp .env.example .env
#
# .env holds a SECRET key, so it is listed in .gitignore and must never be
# committed or shared.
# =====================================================================

# --- Where the server listens -----------------------------------------
PORT=4000
NODE_ENV=development

# --- Supabase (database) ----------------------------------------------
# SUPABASE_URL and the SERVICE ROLE key are the same ones the MeraGhar
# website uses - they are in the parent folder's .env.local.
#
# To find them: Supabase Dashboard > Project Settings > API Keys
#   Project URL          -> SUPABASE_URL
#   service_role / secret key -> SUPABASE_SERVICE_ROLE_KEY
#
# WARNING: the service role key bypasses all database security rules.
# It must stay on the server. Never put it in any file under /public, which
# is sent to the browser, and never commit it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY-HERE

# --- JWT signing secret ------------------------------------------------
# This is what makes a login token unforgeable. Generate a strong random one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Paste the output here. Use a DIFFERENT value on every deployment, and never
# reuse the Supabase key here.
JWT_SECRET=PASTE_A_LONG_RANDOM_STRING_HERE

# --- Optional ----------------------------------------------------------
# Extra CORS origins, comma separated. Leave empty when the HTML is served by
# this same server (the normal case) - then no CORS headers are sent at all.
ALLOWED_ORIGIN=

# --- Rate limiting (optional) ------------------------------------------
# Defaults: 10 credential attempts and 20 photo uploads per 15 min per IP.
# RATE_LIMIT_MAX=100        raise the ceiling for everyone
# RATE_LIMIT=off           switch limiting off (needed by `npm run smoke`)
# Both are ignored when NODE_ENV=production, so brute-force protection can
# never be disabled on a real deployment.
